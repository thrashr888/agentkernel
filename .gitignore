/target
.build/
.worktrees/

# Built kernel binaries (build with: cd images/build && docker run ...)
images/kernel/vmlinux-*

# Built rootfs images
images/rootfs/*.ext4
images/rootfs/*.squashfs

# Benchmark results (generated files)
benchmark-results/*.json
benchmark-results/*.txt
!benchmark-results/.gitkeep

# Plugin install artifacts (generated by: agentkernel plugin install)
/.claude/commands/
/.claude/skills/
/.gemini/
/.mcp.json
/.opencode/

# Tauri desktop app build artifacts
app/src-tauri/target/
app/node_modules/
app/dist/
scripts/node_modules/

# Local Homebrew formula repo (separate repo: thrashr888/homebrew-agentkernel)
/homebrew-agentkernel/

# Dolt database files (added by bd init)
.dolt/
*.db
.beads/dolt-monitor.pid.lock
