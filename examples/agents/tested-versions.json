{
  "schema_version": 1,
  "tested_at": "2026-08-21",
  "defaults": {
    "runtime_user": "developer",
    "workspace": "/workspace"
  },
  "base_images": {
    "node_alpine": {
      "image": "node:24-alpine3.24",
      "node_major": "24",
      "alpine_major_minor": "3.24"
    },
    "node_debian": {
      "image": "node:24-bookworm-slim",
      "node_major": "24"
    },
    "elixir_debian": {
      "image": "elixir:1.19-otp-28-slim",
      "node_major": "24"
    }
  },
  "agents": [
    {
      "id": "codex",
      "display_name": "Codex CLI",
      "description": "OpenAI's coding agent",
      "package": "@openai/codex",
      "version": "0.149.0",
      "install_command": "npm install -g @openai/codex@0.149.0",
      "integration_target": "codex",
      "source": "https://github.com/openai/codex",
      "base": "node_alpine",
      "executable": "codex",
      "smoke_arg": "--version",
      "expected_output": "0.149.0"
    },
    {
      "id": "claude-code",
      "display_name": "Claude Code",
      "description": "Anthropic's coding agent",
      "package": "@anthropic-ai/claude-code",
      "version": "2.1.239",
      "install_command": "npm install -g @anthropic-ai/claude-code@2.1.239",
      "integration_target": "claude",
      "source": "https://docs.anthropic.com/en/docs/claude-code/getting-started",
      "base": "node_alpine",
      "executable": "claude",
      "smoke_arg": "--version",
      "expected_output": "2.1.239"
    },
    {
      "id": "gemini",
      "display_name": "Gemini CLI",
      "description": "Google's coding agent",
      "package": "@google/gemini-cli",
      "version": "0.56.0",
      "install_command": "npm install -g @google/gemini-cli@0.56.0",
      "integration_target": "gemini",
      "source": "https://github.com/google-gemini/gemini-cli",
      "base": "node_alpine",
      "executable": "gemini",
      "smoke_arg": "--version",
      "expected_output": "0.56.0"
    },
    {
      "id": "copilot",
      "display_name": "Copilot CLI",
      "description": "GitHub's coding agent",
      "package": "@github/copilot",
      "version": "1.0.80",
      "install_command": "npm install -g @github/copilot@1.0.80",
      "source": "https://github.com/github/copilot-cli",
      "base": "node_debian",
      "executable": "copilot",
      "smoke_arg": "--version",
      "expected_output": "1.0.80"
    },
    {
      "id": "opencode",
      "display_name": "OpenCode",
      "description": "Open-source coding agent",
      "package": "opencode-ai",
      "version": "1.18.21",
      "install_command": "npm install -g opencode-ai@1.18.21",
      "integration_target": "opencode",
      "source": "https://github.com/anomalyco/opencode",
      "base": "node_alpine",
      "executable": "opencode",
      "smoke_arg": "--version",
      "expected_output": "1.18.21"
    },
    {
      "id": "amp",
      "display_name": "Amp",
      "description": "Amp's coding agent",
      "package": "@ampcode/cli",
      "version": "0.0.1787342526-gc11bfb",
      "install_command": "npm install -g --allow-scripts=@ampcode/cli @ampcode/cli@0.0.1787342526-gc11bfb",
      "integration_target": "amp",
      "source": "https://ampcode.com/news/npm-package-changes",
      "base": "node_debian",
      "executable": "amp",
      "smoke_arg": "--version",
      "expected_output": "c11bfb"
    },
    {
      "id": "pi",
      "display_name": "Pi",
      "description": "Pi coding agent",
      "package": "@earendil-works/pi-coding-agent",
      "version": "0.84.2",
      "install_command": "npm install -g @earendil-works/pi-coding-agent@0.84.2",
      "integration_target": "pi",
      "source": "https://github.com/earendil-works/pi",
      "base": "node_alpine",
      "executable": "pi",
      "smoke_arg": "--version",
      "expected_output": "0.84.2"
    },
    {
      "id": "hermes",
      "display_name": "Hermes Agent",
      "description": "Nous Research's coding agent",
      "version": "0.20.5",
      "install_command": "uv tool install hermes-agent==0.20.5",
      "source": "https://github.com/NousResearch/hermes-agent",
      "source_ref": "fc7523ca31eeb6eff9114afe384c2cf6380359df",
      "base": "node_debian",
      "executable": "hermes",
      "smoke_arg": "--version",
      "expected_output": "0.20.5"
    },
    {
      "id": "symphony",
      "display_name": "Symphony",
      "description": "OpenAI's coding-agent orchestrator",
      "version": "0.0.2",
      "install_command": "git clone https://github.com/openai/symphony",
      "source": "https://github.com/openai/symphony",
      "source_ref": "8001b52e3062495a16e520e4ceaf8f9de868c4d0",
      "base": "elixir_debian",
      "executable": "symphony",
      "smoke_arg": "--help",
      "expected_exit": 1,
      "expected_output": "Usage"
    }
  ]
}
